# Set AUTH_DEV_MODE=1 only for local development. It uses an in-memory
# repository, but verification codes are still delivered through Resend email.
# Codes are never printed to the terminal.
AUTH_DEV_MODE=0
AUTH_HOST=0.0.0.0
AUTH_PORT=8787
AUTH_ALLOWED_ORIGINS=https://admin.example.com,http://localhost:8787
AUTH_TRUST_PROXY=1

# Required for a persistent cloud deployment. Local development can omit these
# two values only if the API is replaced with a separately configured service.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Generate with: node cloud/api/cli.js hash-password
RENMI_ADMIN_EMAIL=judit.astridr@gmail.com
RENMI_ADMIN_USERNAME=Judit Ástríðr
RENMI_ADMIN_PASSWORD_HASH=replace-me

AUTH_SESSION_SECRET=replace-with-random-secret
AUTH_CHALLENGE_SECRET=replace-with-random-secret
AUTH_EMAIL_ENCRYPTION_SECRET=replace-with-random-secret

RESEND_API_KEY=replace-me
AUTH_EMAIL_FROM=renmiao <no-reply@your-domain.example>

# Electron packaging reads this public URL and embeds it in the installer.
# RENMI_AUTH_API_URL=https://renmiao.org
