{
  "name": "renmiao",
  "version": "0.16.0",
  "description": "A friendly desktop companion for focused study, Pomodoro sessions, and ambient sound.",
  "main": "src/main.js",
  "scripts": {
    "start": "node scripts/renmiao-dev.js",
    "dev": "node scripts/renmiao-dev.js",
    "cloud:dev": "node cloud/api/index.js",
    "cloud:hash-password": "node cloud/api/cli.js hash-password",
    "build": "electron-builder --win",
    "build:win:x64": "electron-builder --win nsis:x64",
    "build:win:arm64": "electron-builder --win nsis:arm64",
    "build:win:all": "electron-builder --win nsis:x64 nsis:arm64",
    "build:mac": "electron-builder --mac",
    "build:mac:x64": "electron-builder --mac dmg:x64",
    "build:mac:arm64": "electron-builder --mac dmg:arm64",
    "build:linux": "electron-builder --linux",
    "build:linux:x64": "electron-builder --linux AppImage:x64 deb:x64",
    "build:all": "electron-builder --win --mac --linux",
    "verify:electron": "node scripts/verify-electron-install.js",
    "postinstall": "node scripts/verify-electron-install.js --context postinstall",
    "test": "node test/run-tests.js",
    "audit:assets": "node scripts/audit-repository-assets.js",
    "audit:native-package": "node scripts/audit-packaged-native.js",
    "verify:updater-metadata": "node scripts/verify-updater-metadata.js",
    "verify:winget-arch": "node scripts/verify-winget-arch-contract.js",
    "verify:release": "node scripts/verify-release-version.js && node scripts/verify-release-contributors.js",
    "create-theme": "node scripts/create-theme.js"
  },
  "keywords": [
    "renmi",
    "desktop-pet",
    "electron",
    "study-companion",
    "pomodoro",
    "ambient-sound"
  ],
  "author": "JuditAstridr <judit.astridr@gmail.com>",
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "build": {
    "appId": "com.renmiao.app",
    "productName": "renmiao",
    "afterPack": "scripts/after-pack-koffi.js",
    "mac": {
      "icon": "assets/icon.png",
      "identity": "-",
      "artifactName": "renmiao-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "renmiao-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "JuditAstridr <judit.astridr@gmail.com>",
      "icon": "assets/icons",
      "category": "Utility",
      "artifactName": "renmiao-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "buildUniversalInstaller": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "files": [
      "NOTICE.md",
      "src/main.js",
      "src/main-renmi.js",
      "src/package-koffi-smoke.js",
      "src/native-package-target.js",
      "src/renmi-profile.js",
      "src/renmi-prefs.js",
      "src/renmi-settings-actions.js",
      "src/renmi-shortcut-actions.js",
      "src/settings-controller.js",
      "src/settings-store.js",
      "src/settings-window.js",
      "src/settings-window-icon.js",
      "src/settings-renmi.html",
      "src/settings-renmi.js",
      "src/preload-settings-renmi.js",
      "src/settings.css",
      "src/text-scale.js",
      "src/login-item.js",
      "src/taskbar.js",
      "src/work-area.js",
      "src/size-utils.js",
      "src/display-edge.js",
      "src/drag-position.js",
      "src/visible-margins.js",
      "src/pet-window-runtime.js",
      "src/pet-geometry-main.js",
      "src/pet-accessory-hitbox.js",
      "src/pet-accessory-layout.js",
      "src/pet-accessory-mirror.js",
      "src/pet-accessory-state.js",
      "src/pet-customization-catalog.js",
      "src/holiday-accessory.js",
      "src/idle-visual.js",
      "src/theme-loader.js",
      "src/theme-context.js",
      "src/theme-assets-cache.js",
      "src/theme-metadata.js",
      "src/theme-sanitizer.js",
      "src/theme-schema.js",
      "src/theme-variants.js",
      "src/theme-fade-sequencer.js",
      "src/theme-runtime.js",
      "src/hit-geometry.js",
      "src/renderer.js",
      "src/styles.css",
      "src/index.html",
      "src/ambient-runtime.js",
      "src/ambient-synth.js",
      "src/ambient-ducking.js",
      "src/study-runtime.js",
      "src/study-window.js",
      "src/study-ipc.js",
      "src/study-dashboard.html",
      "src/study-dashboard-renderer.js",
      "src/preload-study-dashboard.js",
      "src/pet-state.js",
      "src/mini.js",
      "src/roam.js",
      "src/tick.js",
      "src/preload-renmi.js",
      "src/preload-hit-renmi.js",
      "src/hit-renderer-renmi.js",
      "src/hit-renmi.html",
      "src/auth-runtime.js",
      "src/auth-client.js",
      "src/auth-config.js",
      "src/auth-session-store.js",
      "src/auth-renderer.js",
      "src/auth.css",
      "src/auth.html",
      "src/preload-auth.js",
      "src/admin-renderer.js",
      "src/admin.css",
      "src/admin.html",
      "src/preload-admin.js",
      "src/account-profile.js",
      "src/i18n.js",
      "src/updater.js",
      "src/secret-redact.js",
      "src/win-cloak-recovery.js",
      "src/window-opacity-transition.js",
      "src/win-fullscreen-detect.js",
      "src/win-foreground-terminal.js",
      "src/mac-window.js",
      "assets/icon.png",
      "assets/icons/*.png",
      "assets/svg/**/*",
      "assets/accessories/**/*",
      "assets/sounds/**/*",
      "assets/dock-icon.png",
      "assets/tray-icon*.png",
      "themes/**/*"
    ],
    "asarUnpack": [
      "assets/svg/**/*",
      "assets/accessories/**/*",
      "themes/**/*",
      "node_modules/jsonc-parser/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "JuditAstridr",
        "repo": "renmiao-on-desk"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^41.10.4",
    "electron-builder": "^26.15.7"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "electron-updater": "^6.8.3",
    "htmlparser2": "^12.0.0",
    "jsonc-parser": "^3.3.1",
    "koffi": "2.16.3",
    "markdown-it": "15.0.0",
    "ws": "^8.21.0"
  }
}
